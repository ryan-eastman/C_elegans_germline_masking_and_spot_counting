  "config": {
    "project": "celegans-germline-quant",
    "io": {
      "input_glob": "**/*.nd2",
      "exclude_patterns": [
        "*largeimage*",
        "*10x*",
        "*_10x_*"
      ],
      "channel_map": "config/channel_maps/n2_dapi_syp3_rad51.yaml"
    },
    "metadata": {
      "filename_regex": "(?P<date>\\d{6,8})_(?P<genotype>[A-Za-z0-9]+)_(?P<treatment>nohs|hs)_(?P<sex>HERM|MALE)\\s*_?(?P<replicate>\\d+)?",
      "defaults": {
        "genotype": "unknown",
        "sex": "unknown",
        "treatment": "unknown",
        "replicate": "NA"
      }
    },
    "segmentation": {
      "nuclei": {
        "method": "auto",
        "cellpose_model": "cpsam",
        "diameter_um": 3.0,
        "min_volume_um3": 4.0,
        "channel": "dna"
      }
    },
    "sc": {
      "enabled": true,
      "channel": "central_element",
      "ridge_sigmas_um": [
        0.15,
        0.25,
        0.4
      ],
      "intensity_percentile": 99.0,
      "min_fragment_length_um": 0.5
    },
    "foci": {
      "enabled": true,
      "channel": "foci",
      "min_sigma_um": 0.1,
      "max_sigma_um": 0.35,
      "threshold_rel": 0.1,
      "count_in": "all_zones"
    },
    "zones": {
      "enabled": true,
      "method": "auto",
      "crescent_boundary": "count_2plus",
      "pachytene_thirds": true,
      "axis_bin_um": 5.0
    },
    "axis": {
      "method": "auto",
      "qc_confidence_min": 0.6
    },
    "granules": {
      "enabled": false,
      "channel": "granule",
      "threshold_method": "li",
      "min_volume_um3": 0.05
    },
    "render": {
      "montage": true,
      "scalebar_um": 10
    },
    "output": {
      "dir": null,
      "formats": [
        "csv",
        "parquet"
      ],
      "write_label_images": true
    }
