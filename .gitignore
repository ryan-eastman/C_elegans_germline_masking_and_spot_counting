# ---- data & outputs (never commit raw microscopy or results) ----
# ignore everything under data/ EXCEPT the drop-folder guide (a parent `data/` rule would
# make the negation below impossible — git can't re-include under a fully-ignored dir).
/data/*
!/data/README.md
outputs/
results/
# local run outputs (results_test, results_fullres, results_nas, results_spotmax_test, ...).
# NOTE: keep this pattern on its OWN line — an inline '# comment' is NOT a comment in .gitignore,
# it becomes part of the pattern and silently breaks the ignore.
results_*/
# the ccw77 coloc analysis tables are small, derived from the pipeline outputs and reviewed; keep them
!/analysis/coloc/results/
*.nd2
*.tif
*.tiff
*.ome.tif
*.ome.tiff
*.czi
*.lif
*.h5
*.zarr/

# ---- python ----
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
env/
.pixi/
*.egg-info/
build/
dist/
.ruff_cache/
.pytest_cache/

# ---- snakemake ----
.snakemake/

# ---- R / positron ----
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# ---- os / editor ----
.DS_Store
.vscode/
.idea/

# trained models (large) + synthetic training data
models/

smoke_crop.npz
smoke.log

# throwaway probes / one-off introspection scripts (underscore-prefixed)
scripts/_*.py

# generated CV manifests + analysis outputs (rebuilt by scripts/build_cv_manifest.py / cv_analyze.py)
cv_manifest*.json
cv_results*/

# benchmark manifests are rebuilt by scripts/benchmark_manifest.py (machine paths and exists flags)
benchmarks/*/manifest.json

# System packs are tracked in full: their model cards sit under models/ and their examples are .ome.tif, both
# ignored everywhere above (docs/DESIGN_system_packs.md 3.7). Only folder-wide negations work: git never
# re-includes a file whose parent folder is excluded. These lines must stay LAST.
!/packs/**
!/tests/fixtures/packs/**
# ...and re-ignore inside packs what the negations would otherwise bring back (caches and .DS_Store)
/packs/**/__pycache__/
/packs/**/*.py[cod]
/packs/**/.DS_Store
/tests/fixtures/packs/**/__pycache__/
/tests/fixtures/packs/**/*.py[cod]
/tests/fixtures/packs/**/.DS_Store
