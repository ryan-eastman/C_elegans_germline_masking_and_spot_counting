# ---- data & outputs (never commit raw microscopy or results) ----
# ignore everything under data/ EXCEPT the drop-folder guide (a parent `data/` rule would
# make the negation below impossible — git can't re-include under a fully-ignored dir).
/data/*
!/data/README.md
outputs/
results/
*.nd2
*.tif
*.tiff
*.ome.tif
*.ome.tiff
*.czi
*.lif
*.h5
*.zarr/

# ---- python ----
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
env/
.pixi/
*.egg-info/
build/
dist/

# ---- snakemake ----
.snakemake/

# ---- R / positron ----
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# ---- os / editor ----
.DS_Store
.vscode/
.idea/
